[TEMPLATE]
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Gemini API keys — placeholder values only. Never put a real key in this
# file; it is committed to git. Use a gitignored local .env instead.
GEMINI_API_KEY=your_gemini_api_key_here
# Server-side only. Loaded by the API (root .env or apps/api/.env) for both AI
# endpoints — POST /api/v1/ai/audit and POST /api/v1/ai/guidance (admin,
# reviewer, governor). Never embedded in the client bundle; the endpoints
# degrade to their deterministic offline fallback when the key is missing.

# Database
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://ethiopia_ai:changeme@localhost:5432/ethiopia_ai_transparency

# API
JWT_SECRET=use_a_strong_random_value_here
JWT_EXPIRES_IN=1d

# Redis
REDIS_URL=redis://localhost:6379
