[TEMPLATE]
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Gemini API keys — placeholder values only. Never put a real key in this
# file; it is committed to git. Use a gitignored local .env instead.
GEMINI_API_KEY=your_gemini_api_key_here
# Server / dev-proxy side only — never embedded in the client bundle. Used by
# the existing neutral human-review guidance flow.

VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Required only by the client-side "AI Transparency Audit" feature, whose audit
# service calls Gemini directly from the browser. Tradeoff: anything prefixed
# with VITE_ is embedded into the built portal JS, so a VITE_ key is readable
# by anyone with browser tools — acceptable for this synthetic demo, never for
# real data. If both keys are set they may share the same value. The app
# degrades to its deterministic offline fallback when either key is missing or
# the Gemini API errors.

# Database
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://ethiopia_ai:changeme@localhost:5432/ethiopia_ai_transparency

# API
JWT_SECRET=use_a_strong_random_value_here
JWT_EXPIRES_IN=1d

# Redis
REDIS_URL=redis://localhost:6379
